# このファイルを「.env」という名前でコピーして、= の右側に値を入れてください。
# .env は Git に入りません(秘密の値を入れるのは .env だけ。このファイルには書かない)。
# 値の取り方は docs/04-line-setup.md を見てください。

# LINE Bot: チャネルシークレット(Messaging API チャネルの「チャネル基本設定」)
LINE_CHANNEL_SECRET=

# LINE Bot: チャネルアクセストークン(Messaging API チャネルの「Messaging API設定」)
LINE_CHANNEL_ACCESS_TOKEN=

# LIFF: LIFF ID(LINE ログインチャネルの「LIFF」タブ)
LIFF_ID=

# サーバーのポート番号(空なら 3000)
PORT=

# Supabase(データの保存先)。2 つとも入れると Supabase に保存し、どちらかが空ならサーバーのメモリに置く(再起動で消える)。
# 値は Supabase のダッシュボード → Project Settings → API Keys(手順は docs/05-deploy.md)
# Supabase: プロジェクトの URL(https://〜.supabase.co)。公開してよい値
SUPABASE_URL=

# Supabase: secret キー(sb_secret_... の形)。⚠ 秘密の値。何でも読み書きできるので、画面(public/)やチャットに絶対に出さない
SUPABASE_SECRET_KEY=
