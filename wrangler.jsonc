// Cloudflare Workers の設定。公開(デプロイ)は npm run deploy。
// 詳しくは docs/05-deploy.md
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bibai-yukikaki",
  "main": "src/worker.ts",
  "compatibility_date": "2025-09-15",
  // Express など Node.js 向けの部品を Workers で動かすための設定
  "compatibility_flags": ["nodejs_compat"],
  // public/ の中の画面ファイルは Cloudflare がそのまま配信する(/liff/ → public/liff/index.html)
  "assets": {
    "directory": "./public"
  },
  // 公開してよい設定値。秘密の値(チャネルシークレット・アクセストークン・Supabase の secret キー)は
  // ここに書かず、npx wrangler secret put で Cloudflare に登録する
  "vars": {
    "LIFF_ID": "2012745330-FLjYEkeQ",
    "SUPABASE_URL": "https://bixvmqnwvtkpvizyttal.supabase.co",
    // テスト用の利用者の切り替え(画面の「🧪 テスト」ボタン)。ハッカソン中だけ "true"。
    // ⚠ 本番の前に必ず "false" にする(docs/05-deploy.md)
    "TEST_MODE": "true"
  },
  "observability": {
    "enabled": true
  }
}
